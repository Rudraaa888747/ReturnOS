# ReturnOS environment configuration (copy to .env or export directly)
# Never commit real secrets.

DATABASE_URL=jdbc:postgresql://localhost:5432/returnos
DATABASE_USER=returnos
DATABASE_PASSWORD=returnos
JWT_SECRET=change-me-to-a-very-long-random-secret-min-32-chars
JWT_EXPIRATION_MS=86400000
RETURN_WINDOW_DAYS=30
BLOCKED_CATEGORIES=
CHANGED_MIND_WINDOW_DAYS=14
PORT=8080
SPRING_PROFILES_ACTIVE=dev
