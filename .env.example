# ReturnOS environment configuration (copy to .env or export directly)
# Never commit real secrets.

DATABASE_URL=jdbc:postgresql://localhost:5432/returnos
DATABASE_USER=returnos
DATABASE_PASSWORD=returnos
JWT_SECRET=change-me-to-a-very-long-random-secret-min-32-chars
JWT_EXPIRATION_MS=86400000
RETURN_WINDOW_DAYS=30
BLOCKED_CATEGORIES=
CHANGED_MIND_WINDOW_DAYS=14
RISK_RECENT_WINDOW_DAYS=30
RISK_POINTS_PER_RECENT_RETURN=8
RISK_MAX_RECENT_POINTS=32
RISK_HIGH_VALUE_THRESHOLD=5000
RISK_MEDIUM_THRESHOLD=30
RISK_HIGH_THRESHOLD=60
DISPOSITION_PROCESSING_COST=150
DISPOSITION_SHIPPING_COST=250
DISPOSITION_REFURBISHMENT_COST=600
DISPOSITION_VENDOR_WINDOW_DAYS=30
PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
