DATABASE_URL=jdbc:postgresql://localhost:5432/returnos
DATABASE_USERNAME=returnos
DATABASE_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=8080
CORS_ORIGINS=http://localhost:5173
# Set true on the public demo so the demo accounts are read-only.
DEMO_MODE=false
# Document storage: 'local' (./uploads default) or 's3'. S3 credentials are
# NEVER placed here — the AWS SDK reads AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY from the environment.
STORAGE_PROVIDER=local
AWS_REGION=ap-south-1
AWS_S3_BUCKET=returnos
